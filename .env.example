# Copia questo file in .env e modificalo (senza .env vanno bene i valori di default)
PORT=3002

# HTTPS: il browser del cliente permette di condividere lo schermo SOLO su HTTPS (o localhost).
# true  = il server crea da solo un certificato autofirmato (il cliente deve confermare un avviso del browser)
# false = usalo solo se metti davanti un reverse proxy / tunnel HTTPS e imposti PUBLIC_URL
HTTPS=true
# (Opzionale) tuo certificato vero, così il cliente non vede nessun avviso
CERT_FILE=
KEY_FILE=
# Con HTTPS attivo il pannello host si apre anche in HTTP semplice, solo da questo PC (0 = disattiva)
# Default: PORT + 1  →  http://localhost:3003
LOCAL_HTTP_PORT=

# Chi può aprire il pannello host (e vedere il bottone "Apri il pannello host" nella home):
# lan   = questo PC + tutti i PC/telefoni collegati alla stessa rete Wi-Fi/LAN (default)
# local = solo il PC dove gira il server (più sicuro)
HOST_ACCESS=lan
# Password del pannello host (minimo 8 caratteri). Se la imposti, il pannello si apre da
# QUALSIASI PC/telefono (anche da internet) dopo aver inserito la password: il bottone
# "Apri il pannello host" compare per tutti e porta alla schermata di accesso.
# Consigliato se il server è su un indirizzo pubblico (VPS). Usa HTTPS per proteggerla.
HOST_PASSWORD=
# Sulla porta host (3003) la password viene SEMPRE chiesta. Se lasci vuoto, ne viene generata una
# casuale al primo avvio (salvata in backend/data/host-password.json e stampata in console).
# IP extra autorizzati, separati da virgola (anche prefissi, es. 100.64.). Vuoto = nessuno.
HOST_ALLOWED_IPS=176.206.119.186

# Link da dare al cliente: generato al primo avvio e salvato in backend/data/access.json.
# Se vuoi un link fisso scegline uno tu (16-64 caratteri tra lettere, numeri, - e _).
ACCESS_TOKEN=

# (Opzionale) indirizzo pubblico con cui il cliente raggiunge il server (dominio o tunnel HTTPS),
# es. https://remoto.miodominio.it
PUBLIC_URL=

# Codice OTP: durata in secondi
OTP_TTL_SECONDS=90

# Minuti di inattività prima che una sessione non ancora attiva scada
SESSION_IDLE_MINUTES=30

# Qualità del video: frame al secondo massimi e bitrate massimo (kbit/s)
MAX_FPS=15
MAX_BITRATE_KBPS=3000

# Server per far collegare i due browser (WebRTC). STUN di default; TURN solo per reti molto restrittive
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USER=
TURN_PASS=

# true se metti il server dietro un proxy HTTPS (cookie "Secure")
COOKIE_SECURE=false

# Fuso orario del cron di pulizia del cestino
TZ=Europe/Rome
